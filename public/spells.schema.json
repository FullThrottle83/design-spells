{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-spells.hultsan20.workers.dev/spells.schema.json",
  "title": "Design Spells catalogue",
  "description": "Machine-readable contract for the design-spells catalogue. Generated by scripts/build.py alongside public/spells.json. AI agents and editors should treat this as the authoritative shape of every spell.",
  "type": "object",
  "required": [
    "supportAsOf",
    "total",
    "spells"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Points back at this schema document; present in public/spells.json."
    },
    "supportAsOf": {
      "type": "string",
      "description": "Date of the hand-maintained compatibility snapshot; not proof of individual browser testing."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of spells in the catalogue."
    },
    "spells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spell"
      }
    }
  },
  "$defs": {
    "browserLevel": {
      "type": "string",
      "enum": [
        "yes",
        "partial",
        "no"
      ]
    },
    "previewAction": {
      "type": "object",
      "required": [
        "kind",
        "hint"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "invalid-input",
            "activate-control",
            "toggle-disclosure",
            "adjust-range",
            "scroll",
            "resize",
            "swipe",
            "activate-link",
            "select-text",
            "toggle-control",
            "hover-or-focus",
            "hover",
            "keyboard-focus",
            "focus",
            "press"
          ]
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "spell": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "section",
        "category",
        "rawCategory",
        "status",
        "statusLabel",
        "jsNeed",
        "jsLabel",
        "note",
        "description",
        "html",
        "css",
        "previewEnvironment",
        "previewAction",
        "previewHtml",
        "previewCss",
        "featureKeys",
        "feature",
        "browsers",
        "supportNote",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier, e.g. \"ds-43\". Refer to spells by this value."
        },
        "number": {
          "type": "string",
          "description": "The spell's canonical number (e.g. \"43\") or \"bonus\"."
        },
        "title": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "Top-level section the spell lives under in the source document."
        },
        "category": {
          "type": "string",
          "description": "Normalised functional category used for filtering (e.g. Interaction, Scroll, Overlays)."
        },
        "rawCategory": {
          "type": "string",
          "description": "Category as authored in the source document."
        },
        "status": {
          "type": "string",
          "enum": [
            "baseline",
            "newer",
            "progressive"
          ],
          "description": "Lower-cased browser-risk status."
        },
        "statusLabel": {
          "type": "string",
          "enum": [
            "Baseline",
            "Newer",
            "Progressive"
          ],
          "description": "Human-facing status label."
        },
        "jsNeed": {
          "type": "string",
          "enum": [
            "none",
            "markup"
          ],
          "description": "\"none\" = zero JS; \"markup\" = zero JS but requires a specific native HTML pattern."
        },
        "jsLabel": {
          "type": "string",
          "enum": [
            "0 JS",
            "Markup"
          ]
        },
        "note": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "html": {
          "type": "string",
          "description": "Required markup (may be empty for CSS-only spells)."
        },
        "css": {
          "type": "string",
          "description": "The modern-CSS source to copy."
        },
        "previewEnvironment": {
          "type": "string",
          "enum": [
            "shadow",
            "document"
          ],
          "description": "Isolation model used by the live preview."
        },
        "previewAction": {
          "$ref": "#/$defs/previewAction"
        },
        "previewHtml": {
          "type": "string",
          "description": "Self-contained markup used by the live preview."
        },
        "previewCss": {
          "type": "string",
          "description": "Preview CSS with :root/html/body rewritten to :host for the shadow-DOM sandbox."
        },
        "featureKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "All detected compatibility feature keys in registry order."
        },
        "feature": {
          "type": "string",
          "description": "Human-readable summary of the CSS features the spell depends on."
        },
        "browsers": {
          "type": "object",
          "required": [
            "chrome",
            "edge",
            "firefox",
            "safari"
          ],
          "additionalProperties": false,
          "properties": {
            "chrome": {
              "$ref": "#/$defs/browserLevel"
            },
            "edge": {
              "$ref": "#/$defs/browserLevel"
            },
            "firefox": {
              "$ref": "#/$defs/browserLevel"
            },
            "safari": {
              "$ref": "#/$defs/browserLevel"
            }
          }
        },
        "supportNote": {
          "type": "string",
          "description": "Detailed browser-support note, including version numbers where relevant."
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "support",
        "behavior",
        "accessibility",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "support": {
          "type": "string",
          "enum": [
            "registry-estimate",
            "source-checked"
          ]
        },
        "behavior": {
          "type": "string",
          "enum": [
            "not-individually-verified",
            "browser-tested"
          ]
        },
        "accessibility": {
          "type": "string",
          "enum": [
            "not-audited",
            "reviewed"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Per-spell URLs supporting a manual verification; empty for unreviewed registry estimates."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationEvidence"
          },
          "description": "Dated scoped provenance; required for promoted claims."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Reviewed functional dependencies, if known."
        },
        "fallback": {
          "type": "string",
          "description": "Reviewed fallback requirements, if known."
        },
        "accessibilityNotes": {
          "type": "string",
          "description": "Scope and limitations of any accessibility review; no automatic WCAG claim."
        }
      }
    },
    "verificationEvidence": {
      "type": "object",
      "required": [
        "kind",
        "url",
        "checkedAt",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "support",
            "behavior",
            "accessibility"
          ]
        },
        "url": {
          "type": "string",
          "description": "HTTPS evidence URL, enforced at build time."
        },
        "checkedAt": {
          "type": "string",
          "description": "Date YYYY-MM-DD, enforced at build time."
        },
        "note": {
          "type": "string",
          "description": "Specific observation or source scope."
        },
        "browser": {
          "type": "string",
          "enum": [
            "chromium",
            "firefox",
            "webkit",
            "chrome",
            "edge",
            "safari"
          ]
        },
        "version": {
          "type": "string",
          "description": "Actual browser version for tested behavior."
        }
      }
    }
  }
}
